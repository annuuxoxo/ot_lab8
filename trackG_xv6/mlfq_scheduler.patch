diff --git a/kernel/pstat.h b/kernel/pstat.h
new file mode 100644
index 0000000..e6069b5
--- /dev/null
+++ b/kernel/pstat.h
@@ -0,0 +1,10 @@
+// Per-process scheduling statistics returned by the waitstat() system call (Track G).
+// All times are in timer ticks (about 0.1 s each under QEMU).
+struct procstat {
+  int pid;
+  uint ctime;   // tick when the process was created
+  uint stime;   // tick when it was first scheduled
+  uint etime;   // tick when it exited
+  uint rtime;   // ticks spent RUNNING
+  int level;    // MLFQ queue level when it exited (always 0 under round-robin)
+};
