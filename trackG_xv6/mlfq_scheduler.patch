diff --git a/user/schedbench.c b/user/schedbench.c
new file mode 100644
index 0000000..f8e50a8
--- /dev/null
+++ b/user/schedbench.c
@@ -0,0 +1,93 @@
+// Track G: scheduler benchmark.
+//   schedbench 0          calibration: ticks taken by spin(UNITS)
+//   schedbench 1          mixed: 3 CPU-bound + 3 I/O-bound (interactive) processes started together
+//   schedbench 2          short vs long: 1 long CPU job, then 4 short CPU jobs arrive 2 ticks later
+//   schedbench 3          equal: 4 identical CPU-bound jobs (fairness / overhead check)
+// For every child it prints one line:
+//   STAT <workload> <kind> <pid> <ctime> <stime> <etime> <rtime> <level>
+// turnaround = etime - ctime, response = stime - ctime, waiting = turnaround - rtime (in ticks, ~0.1 s each).
+#include "kernel/types.h"
+#include "kernel/pstat.h"
+#include "user/user.h"
+
+#define UNITS 2000  // CPU work of one long job: about 20 ticks (2 s) alone (calibrated: 800 units = 8 ticks)
+
+static int pids[16];
+static char *kinds[16];
+static int nkids;
+
+volatile uint sink;  // the busy loop writes here so the compiler cannot remove it
+
+void
+spin(int units)
+{
+  uint x = 0;
+  for (int u = 0; u < units; u++)
+    for (int i = 0; i < 1000000; i++)
+      sink = x += i ^ u;
+}
+
+void
+spawn(char *kind, int units, int io_rounds)
+{
+  int pid = fork();
+  if (pid < 0) {
+    printf("fork failed\n");
+    exit(1);
+  }
+  if (pid == 0) {
+    if (io_rounds > 0) {
+      for (int r = 0; r < io_rounds; r++) {  // interactive: a little CPU, then block (sleep) for 1 tick
+        spin(units);
+        pause(1);
+      }
+    } else {
+      spin(units);
+    }
+    exit(0);
+  }
+  pids[nkids] = pid;
+  kinds[nkids] = kind;
+  nkids++;
+}
+
+int
+main(int argc, char *argv[])
+{
+  int w = argc > 1 ? atoi(argv[1]) : 1;
+  if (w == 0) {
+    int t0 = uptime();
+    spin(UNITS);
+    printf("CALIB %d units took %d ticks\n", UNITS, uptime() - t0);
+    exit(0);
+  }
+  if (w == 1) {
+    for (int i = 0; i < 3; i++)
+      spawn("cpu", UNITS, 0);
+    for (int i = 0; i < 3; i++)
+      spawn("io", 8, 10);  // ~0.2 ticks of CPU, then sleep 1 tick; 10 rounds
+  } else if (w == 2) {
+    spawn("long", UNITS, 0);
+    pause(2);
+    for (int i = 0; i < 4; i++)
+      spawn("short", UNITS / 8, 0);
+  } else if (w == 3) {
+    for (int i = 0; i < 4; i++)
+      spawn("cpu", UNITS / 2, 0);
+  }
+  for (int k = 0; k < nkids; k++) {
+    int status;
+    struct procstat ps;
+    if (waitstat(&status, &ps) < 0) {
+      printf("waitstat failed\n");
+      exit(1);
+    }
+    char *kind = "?";
+    for (int j = 0; j < nkids; j++)
+      if (pids[j] == ps.pid)
+        kind = kinds[j];
+    printf("STAT %d %s %d %d %d %d %d %d\n", w, kind, ps.pid, ps.ctime, ps.stime, ps.etime, ps.rtime, ps.level);
+  }
+  printf("DONE %d\n", w);
+  exit(0);
+}
