+// Switch to process p (p->lock held, p RUNNABLE) and come back when it gives up the CPU.
+void
+run_proc(struct cpu *c, struct proc *p)
+{
+  if (!p->scheduled) {  // first time on a CPU: record response time
+    p->scheduled = 1;
+    p->stime = ticks;
+  }
+  // Switch to chosen process.  It is the process's job
+  // to release its lock and then reacquire it
+  // before jumping back to us.
+  p->state = RUNNING;
+  c->proc = p;
+  swtch(&c->context, &p->context);
+
+  // Don't re-enable interrupts on release.
+  mycpu()->intena = 0;
+
+  // Process is done running for now.
+  // It should have changed its p->state before coming back.
+  c->proc = 0;
+}
+
+#ifdef SCHED_MLFQ
+// Every MLFQ_BOOST ticks put every process back in the top queue.
+void
+mlfq_maybe_boost(void)
+{
+  struct proc *p;
+  acquire(&boost_lock);
+  if (ticks - last_boost < MLFQ_BOOST) {
+    release(&boost_lock);
+    return;
+  }
+  last_boost = ticks;
+  release(&boost_lock);
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    p->level = 0;
+    p->slice_used = 0;
+    release(&p->lock);
+  }
+}
+#endif
+
+// Called from the timer interrupt for the process running on this CPU.
+// Charges it one tick and returns 1 if it should give up the CPU now.
+int
+sched_tick(void)
+{
+  struct proc *p = myproc();
+  int give_up = 1;  // round-robin: preempt on every tick
+  acquire(&p->lock);
+  p->rtime++;
+#ifdef SCHED_MLFQ
+  int mylevel = p->level;
+  p->slice_used++;
+  if (p->slice_used >= mlfq_quantum[p->level]) {  // used its whole slice: demote
+    if (p->level < NMLFQ - 1)
+      p->level++;
+    p->slice_used = 0;
+    give_up = 1;
+  } else {
+    give_up = 0;
+  }
+  release(&p->lock);
+  // Preempt early if a higher-priority process is waiting (e.g. an I/O-bound process just woke up).
+  // Unlocked reads: only a hint, the scheduler re-checks under the lock.
+  if (!give_up) {
+    for (struct proc *q = proc; q < &proc[NPROC]; q++) {
+      if (q != p && q->state == RUNNABLE && q->level < mylevel) {
+        give_up = 1;
+        break;
+      }
+    }
+  }
+  return give_up;
+#else
+  release(&p->lock);
+  return give_up;
+#endif
+}
+
